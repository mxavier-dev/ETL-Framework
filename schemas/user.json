{
    "id": {
        "type": "int"
    },
    "name": {
        "type": "str",
        "transform": "clean_name",
        "clean": true
    },
    "age": {
        "type": "int",
        "min": 0,
        "max": 120
    },
    "email": {
        "type": "str",
        "contains": "@"
    },
    "phone": {
        "type": "str",
        "transform": "clean_phone",
        "clean": true
    },
    "city": {
        "source": "address.city",
        "type": "str"
    },
    "company": {
        "source": "company.name",
        "type": "str"
    }
}
